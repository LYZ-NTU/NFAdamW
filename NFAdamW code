_dde_optimizer_get = dde.optimizers.get
def _get_optimizer_compat(optimizer, learning_rate=None, decay=None):
    if isinstance(optimizer, Optimizer):
        return optimizer
    return _dde_optimizer_get(optimizer, learning_rate=learning_rate, decay=decay)
dde.optimizers.get = _get_optimizer_compat

a = np.pi
h = 0.25
ordered = 0.035
NUMPY_DTYPE = np.float32
FINAL_EPOCHS = 10000
lr_nfgl = 0.001
COMMON_BETA1 = 0.9
CD_BETA1 = 0.91
