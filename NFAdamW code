def sol(xy):
    x, y = xy[:, :1], xy[:, 1:2]
    return np.sin(a*x)*np.sin(2*a*y)

def du_x(xy):
    x, y = xy[:, :1], xy[:, 1:2]
    return a*np.cos(a*x)*np.sin(2*a*y)

def du_y(xy):
    x, y = xy[:, :1], xy[:, 1:2]
    return 2*a*np.sin(a*x)*np.cos(2*a*y)

def q(xy):
    return (1-5*a**2)*tf.sin(a*xy[:, :1])*tf.sin(2*a*xy[:, 1:2])

def PINNpde(xy, u):
    return (dde.grad.hessian(u,xy,i=0,j=0)
            +dde.grad.hessian(u,xy,i=1,j=1)+u-q(xy))

# Named operators avoid source-location ambiguity in TensorFlow AutoGraph.
def jac_x(xy,u):
    return dde.grad.jacobian(u,xy,j=0)

def jac_y(xy,u):
    return dde.grad.jacobian(u,xy,j=1)

def hess_xx(xy,u):
    return dde.grad.hessian(u,xy,i=0,j=0)

def hess_yy(xy,u):
    return dde.grad.hessian(u,xy,i=1,j=1)

def output_transform(xy, raw):
    x, y = xy[:, :1], xy[:, 1:2]
    return (1-x*x)*(1-y*y)*raw

class GLFractionalAdamW(Optimizer):
    """
    基于Grünwald-Letnikov分数阶导数的AdamW优化器
    """
    def __init__(self, learning_rate=lr_nfgl, beta1=0.9, beta2=0.999, epsilon=1e-8,
                 ordered=ordered, weight_decay=weight_decay, h=h,
                 name="GLFractionalAdamW", **kwargs):
        super().__init__(name, **kwargs)
        self._set_hyper("learning_rate", learning_rate)
        self._set_hyper("beta1", beta1)
        self._set_hyper("beta2", beta2)
        self._set_hyper("epsilon", epsilon)
        self.ordered = ordered
        self.weight_decay = weight_decay
        self.h = h

    def _create_slots(self, var_list):
        for var in var_list:
            self.add_slot(var, "m")
            self.add_slot(var, "v")

    def _gl_fractional_gradient(self, grad, ordered, h):
        n = min(int(1 / h), 40)
        grad_frac = tf.zeros_like(grad)
        for k in range(n):
            coeff = (-1) ** k * gamma(ordered + 1) / (gamma(k + 1) * gamma(ordered - k + 1) + 1e-12)
            grad_frac += coeff * tf.roll(grad, -k, axis=0)
        return grad_frac * (h ** (-ordered))

    def _resource_apply_dense(self, grad, var):
        lr = self._get_hyper("learning_rate", var.dtype)
        beta1 = self._get_hyper("beta1", var.dtype)
        beta2 = self._get_hyper("beta2", var.dtype)
        eps = self._get_hyper("epsilon", var.dtype)
        t = tf.cast(self.iterations + 1, var.dtype)
        wd = tf.cast(self.weight_decay, var.dtype)

        m = self.get_slot(var, "m")
        v = self.get_slot(var, "v")

        grad_frac = self._gl_fractional_gradient(grad, self.ordered, self.h)

        m_t = beta1 * m + (1 - beta1) * grad_frac
        v_t = beta2 * v + (1 - beta2) * tf.square(grad_frac)

        m_hat = m_t / (1 - tf.pow(beta1, t) + 1e-12)
        v_hat = v_t / (1 - tf.pow(beta2, t) + 1e-12)

        var_decay = var.assign(var * (1.0 - lr * wd))
        with tf.control_dependencies([var_decay]):
            var_update = var.assign_sub(lr * m_hat / (tf.sqrt(v_hat) + eps))

        m.assign(m_t)
        v.assign(v_t)
        return tf.group(var_update, m_t, v_t)

    def get_config(self):
        config = super().get_config()
        config.update({
            "learning_rate": self._serialize_hyperparameter("learning_rate"),
            "beta1": self._serialize_hyperparameter("beta1"),
            "beta2": self._serialize_hyperparameter("beta2"),
            "epsilon": self._serialize_hyperparameter("epsilon"),
            "ordered": self.ordered,
            "weight_decay": self.weight_decay,
            "h": self.h
        })
        return config


# ===================== SimpleAdamW =====================
class SimpleAdamW(Optimizer):
    def __init__(self, learning_rate=lr_nfgl, beta1=0.9, beta2=0.999, epsilon=1e-8,
                 weight_decay=weight_decay, name="SimpleAdamW", **kwargs):
        super().__init__(name, **kwargs)
        self._set_hyper("learning_rate", learning_rate)
        self._set_hyper("beta1", beta1)
        self._set_hyper("beta2", beta2)
        self._set_hyper("epsilon", epsilon)
        self.weight_decay = weight_decay

    def _create_slots(self, var_list):
        for var in var_list:
            self.add_slot(var, "m")
            self.add_slot(var, "v")

    def _resource_apply_dense(self, grad, var):
        lr = self._get_hyper("learning_rate", var.dtype)
        beta1 = self._get_hyper("beta1", var.dtype)
        beta2 = self._get_hyper("beta2", var.dtype)
        eps = self._get_hyper("epsilon", var.dtype)
        t = tf.cast(self.iterations + 1, var.dtype)
        wd = tf.cast(self.weight_decay, var.dtype)

        m = self.get_slot(var, "m")
        v = self.get_slot(var, "v")

        m_t = beta1 * m + (1 - beta1) * grad
        v_t = beta2 * v + (1 - beta2) * tf.square(grad)
        m_hat = m_t / (1 - tf.pow(beta1, t) + 1e-12)
        v_hat = v_t / (1 - tf.pow(beta2, t) + 1e-12)

        var_update = var.assign_sub(lr * m_hat / (tf.sqrt(v_hat) + eps))
        with tf.control_dependencies([var_update]):
            var_decay = var.assign(var * (1.0 - lr * wd))

        m.assign(m_t)
        v.assign(v_t)
        return tf.group(var_decay, m_t, v_t)

    def get_config(self):
        config = super().get_config()
        config.update({
            "learning_rate": self._serialize_hyperparameter("learning_rate"),
            "beta1": self._serialize_hyperparameter("beta1"),
            "beta2": self._serialize_hyperparameter("beta2"),
            "epsilon": self._serialize_hyperparameter("epsilon"),
            "weight_decay": self.weight_decay,
        })
        return config

